# Copier en `.env` puis renseigner les valeurs.
# Ce fichier est versionné ; `.env` ne doit jamais l'être.

# --- Images ------------------------------------------------------------------
# Compte GitHub propriétaire des images, en minuscules.
# Les images publiées sont ghcr.io/<GHCR_OWNER>/maxoujeux-api et -web.
GHCR_OWNER=maxcoeur

# Version déployée. `latest` suit la branche main.
# Pour revenir en arrière, mettre l'étiquette courte d'un commit — visible dans
# le récapitulatif du workflow « Images Docker » :
#   TAG=sha-abc1234
TAG=latest

# Fuseau des conteneurs. Confort de lecture des journaux ; la logique MaxouCoin
# nomme Europe/Paris explicitement dans le code et n'en dépend pas.
TZ=Europe/Paris

# --- Exposition --------------------------------------------------------------
# Le TLS, le domaine et le certificat sont gérés par Nginx Proxy Manager sur le
# NAS. Cette pile ne publie qu'un seul port HTTP, vers lequel NPM pointe.

# Port publié sur le NAS, cible de l'hôte mandataire NPM.
# 8080 par défaut : 80 et 443 sont déjà pris par NPM lui-même.
WEB_PORT=8080

# Origine publique complète, telle que la voit le navigateur (donc en https,
# le domaine étant servi par NPM). Utilisée par l'API pour le réglage du
# cookie de session et le contrôle d'origine du handshake WebSocket.
PUBLIC_ORIGIN=https://maxoujeux.maxencecoeur.fr

# --- Base de données ---------------------------------------------------------
POSTGRES_DB=maxoujeux
POSTGRES_USER=maxoujeux
# Générer une valeur longue et aléatoire :
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Sessions ----------------------------------------------------------------
# Clé de signature des cookies, 32 caractères minimum.
# Générer :
#   openssl rand -base64 48
# La changer déconnecte tout le monde ; ne pas la faire tourner sans raison.
SESSION_SECRET=

SESSION_TTL_DAYS=30

# --- Administration ----------------------------------------------------------
# Les trois valeurs doivent être présentes ensemble. Elles servent à créer ou
# promouvoir l'administrateur initial et ne réinitialisent pas son mot de passe
# après sa création.
ADMIN_EMAIL=admin@example.com
ADMIN_PSEUDO=Admin
# 10 caractères minimum ; utilisé uniquement à la création initiale.
ADMIN_PASSWORD=

# --- Jeu ---------------------------------------------------------------------
# Jetons virtuels offerts à l'inscription. Sans valeur monétaire.
STARTING_BALANCE=5000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
