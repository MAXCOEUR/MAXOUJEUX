{
  "name": "maxoujeux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @maxoujeux/api --filter @maxoujeux/web dev",
    "build": "pnpm --filter @maxoujeux/api build && pnpm --filter @maxoujeux/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @maxoujeux/api db:generate",
    "db:studio": "pnpm --filter @maxoujeux/api db:studio"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
